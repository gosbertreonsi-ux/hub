# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# DATABASE CONFIGURATION (Docker PostgreSQL or local SQLite/JSON engine)
# ============================================================================
DATABASE_URL="postgres://postgres:postgres@localhost:5432/mizizi_db"

# ============================================================================
# REAL PAYMENT GATEWAYS (Ready to drop in your live API keys)
# ============================================================================
# Stripe (Cards, Apple Pay, Google Pay)
STRIPE_PUBLISHABLE_KEY="pk_test_sample_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_sample_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_sample_stripe_webhook_secret"

# PayPal Subscriptions & Checkout
PAYPAL_CLIENT_ID="sample_paypal_client_id"
PAYPAL_CLIENT_SECRET="sample_paypal_client_secret"

# Mobile Money (M-Pesa / Tigo Pesa / Airtel Money / Vodacom / Flutterwave)
MPESA_CONSUMER_KEY="sample_mpesa_consumer_key"
MPESA_CONSUMER_SECRET="sample_mpesa_consumer_secret"
FLUTTERWAVE_SECRET_KEY="sample_flutterwave_secret_key"

